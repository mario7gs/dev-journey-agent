<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Dev Journey case study</title>
  <style>
{% include 'assets/brand.css' %}
    :root { --ink: var(--dj-ink); --muted: var(--dj-muted); --indigo: var(--dj-indigo); --paper: var(--dj-paper); }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--dj-mist); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    body { padding: 0; }
    .deck { display: grid; gap: 2rem; justify-items: center; padding: 2rem; }
    .slide { position: relative; width: min(100%, 16in); min-height: min(56.25vw, 9in); aspect-ratio: 16 / 9; overflow: hidden; padding: 7%; background: var(--paper); box-shadow: 0 1rem 3rem rgba(11, 18, 32, .16); page-break-after: always; }
    .slide::after { content: ''; position: absolute; right: -8rem; bottom: -10rem; width: 22rem; height: 22rem; border-radius: 50%; background: rgba(49, 87, 213, .08); }
    .eyebrow { color: var(--indigo); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    h1 { max-width: 11ch; margin: 1.5rem 0 1rem; font-size: clamp(2rem, 5vw, 5rem); line-height: .98; letter-spacing: -.04em; }
    h2 { margin: 0 0 1.25rem; font-size: clamp(1.5rem, 3vw, 3rem); letter-spacing: -.03em; }
    p, li { max-width: 58ch; color: var(--dj-slate); font-size: clamp(.9rem, 1.4vw, 1.25rem); line-height: 1.45; }
    ul { padding-left: 1.2rem; }
    .brand { display: flex; align-items: center; gap: .75rem; color: var(--ink); font-weight: 800; letter-spacing: .12em; }
    .brand img { width: 3rem; height: 3rem; }
    .brand small { display: block; margin-top: .2rem; color: var(--dj-muted); font-size: .62rem; letter-spacing: .1em; }
    .meta { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; }
    .pill { padding: .5rem .75rem; border-radius: 999px; background: var(--dj-indigo-soft); color: var(--indigo); font-size: .85rem; font-weight: 700; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .card { padding: 1.25rem; border: 1px solid var(--dj-line); border-radius: 1rem; background: var(--dj-paper); }
    .card strong { display: block; margin-bottom: .35rem; color: var(--ink); }
    .stat { font-size: clamp(1.7rem, 4vw, 3.5rem); font-weight: 850; color: var(--dj-teal); }
    .footer { position: absolute; right: 7%; bottom: 5%; color: var(--dj-muted); font-size: .75rem; }
    .status { color: var(--dj-success); }
    @media print {
      @page { size: 16in 9in; margin: 0; }
      body { padding: 0; background: #fff; }
      .deck { display: block; padding: 0; }
      .slide { width: 16in; height: 9in; min-height: 9in; box-shadow: none; }
      .slide:last-child { page-break-after: auto; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
    @media (max-width: 700px) {
      .deck { padding: .5rem; }
      .slide { min-height: 80vh; aspect-ratio: auto; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header class="site-header" aria-label="Case study navigation">
    <div class="site-header-inner">
      <a class="site-brand" href="#overview" aria-label="Dev Journey Agent overview">
        <span class="brand-mark-frame"><img src="{{ brand_mark_png_data_uri }}" alt="Dev Journey Agent mark"></span>
        <span><span class="brand-name">DEV JOURNEY</span><span class="brand-subtitle">AGENT · FEATURE PLANNING COPILOT</span></span>
      </a>
      <nav class="site-nav" aria-label="Case study sections">
        <a href="#overview">Overview</a>
        <a href="#problem">Problem</a>
        <a href="#delivery">Delivery</a>
        <a href="#evidence">Evidence</a>
        <a href="#outcome">Outcome</a>
      </nav>
    </div>
  </header>
  <main class="deck">
    <section class="slide" id="overview" aria-labelledby="slide-title">
      <div class="eyebrow" style="margin-top: 4rem">Feature planning case study</div>
      <h1 id="slide-title">{{ title }}</h1>
      <p>{{ refined_ticket or ticket }}</p>
      <div class="meta"><span class="pill status">{{ status|upper }}</span><span class="pill">{{ mode|capitalize }} mode</span>{% if repo_ref %}<span class="pill">{{ repo_ref }} · {{ branch }}</span>{% endif %}</div>
      <div class="footer">01 / 05</div>
    </section>

    <section class="slide" id="problem" aria-labelledby="problem-title">
      <div class="eyebrow">The problem</div>
      <h2 id="problem-title">Turn a vague request into a decision-ready plan.</h2>
      <div class="grid">
        <div class="card"><strong>Input</strong><p>{{ ticket or "A rough ticket with incomplete scope and unknown constraints." }}</p></div>
        <div class="card"><strong>Refinement</strong><p>{{ refined_ticket or "The request is clarified before downstream planning begins." }}</p></div>
        <div class="card"><strong>Traceability</strong><p>Requirements connect to contracts, acceptance criteria, tests, and implementation steps.</p></div>
        <div class="card"><strong>Trust gate</strong><p>Blocking mode pauses when clarification or high-severity gaps remain.</p></div>
      </div>
      <div class="footer">02 / 05</div>
    </section>

    <section class="slide" id="delivery" aria-labelledby="delivery-title">
      <div class="eyebrow">The delivery system</div>
      <h2 id="delivery-title">One pipeline, with evidence at every handoff.</h2>
      <div class="grid">
        <div class="card"><span class="stat">01</span><strong>Refine</strong><p>Surface questions, gaps, and assumptions.</p></div>
        <div class="card"><span class="stat">02</span><strong>Specify</strong><p>Define PRD, technical design, security, and contracts.</p></div>
        <div class="card"><span class="stat">03</span><strong>Test</strong><p>Turn acceptance into a TDD suite and implementation roadmap.</p></div>
        <div class="card"><span class="stat">04</span><strong>Export</strong><p>Deliver Markdown, stakeholder HTML, PDF, and this case-study view.</p></div>
      </div>
      <div class="footer">03 / 05</div>
    </section>

    <section class="slide" id="evidence" aria-labelledby="evidence-title">
      <div class="eyebrow">Evidence and operations</div>
      <h2 id="evidence-title">The result is reviewable, resumable, and measurable.</h2>
      <div class="grid">
        <div class="card"><span class="stat">{{ requirements|length }}</span><strong>Requirements</strong><p>Captured in the product definition.</p></div>
        <div class="card"><span class="stat">{{ dod_items|length }}</span><strong>DoD checks</strong><p>Verifiable acceptance conditions.</p></div>
        <div class="card"><span class="stat">{{ test_count }}</span><strong>Test cases</strong><p>Planned checks linked to requirements and contracts.</p></div>
        <div class="card"><span class="stat">{{ implementation_count }}</span><strong>Build steps</strong><p>Sequenced implementation work with a {{ coverage_target }}% target.</p></div>
      </div>
      <div class="footer">04 / 05</div>
    </section>

    <section class="slide" id="outcome" aria-labelledby="outcome-title">
      <div class="eyebrow">Outcome</div>
      <h2 id="outcome-title">A portfolio artifact that makes progress easy to inspect.</h2>
      <p class="status">{{ "Approved for implementation" if approved else "Requires clarification before approval" }}</p>
      {% if block_reasons %}<ul>{% for reason in block_reasons %}<li>{{ reason }}</li>{% endfor %}</ul>{% else %}<p>The planning record is ready to hand to a development team, with the source Markdown and stakeholder report available alongside this presentation.</p>{% endif %}
      <div class="meta"><span class="pill">PDF-ready</span><span class="pill">Accessible headings</span><span class="pill">Self-contained brand asset</span></div>
      <div class="footer">05 / 05{% if run_id %} · {{ run_id }}{% endif %}</div>
    </section>
  </main>
</body>
</html>
