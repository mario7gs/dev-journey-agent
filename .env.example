# Copy to .env and fill in. MVP runs with mocks (no keys required).
USE_MOCK_LLM=true
OPENAI_API_KEY=
GITHUB_TOKEN=
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=dev-journey-agent
TELEMETRY_PATH=.dev-journey/telemetry/events.jsonl
PRIMARY_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini
LOCAL_MODEL=ollama/llama3
LLM_TIMEOUT_SECONDS=60
REPO_CONTEXT_BUDGET_TOKENS=20000
REPO_CONTEXT_MAX_FILES=80
CHECKPOINT_DIR=.dev-journey/checkpoints
